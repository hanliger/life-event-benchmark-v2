# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# openai | anthropic | gemini | google | mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_GENERATION_MODEL=mock
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# comma-separated provider:model list used by the history filter
HISTORY_FILTER_VALIDATORS=mock:mock-validator

# Dialogue corpus source. This repo is code-only; when a sessions directory has
# no sessions_*.jsonl, consumers fetch them from this private HF dataset.
HF_DIALOGUE_REPO=hangyeul-lee/life-event-benchmark-v2-dialogues
# HF_DIALOGUE_REVISION=main
# HF_DIALOGUE_SUBDIR=
# Access token for the private dataset (also read from HUGGINGFACE_TOKEN).
HF_TOKEN=
