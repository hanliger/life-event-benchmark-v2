.env
.venv/
venv/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large upstream persona parquet shards. Keep the adapter/configuration in git,
# but fetch or mount the raw dataset separately.
Nemotron-Personas-Korea/data/*.parquet
Nemotron-Personas-Korea/.cache/

# Generated pipeline outputs — NOT tracked. Regenerate from source with the
# Makefile targets (see README "실행 가이드라인"). Code, configs, prompts and
# docs are enough to reproduce everything.
data/generated/
data/personas/normalized/
data/raw_model_outputs/

# Dialogue execution artifacts. Keep frozen plans and source trajectories in
# git; canaries, provider responses, logs, and generated sessions are local or
# release artifacts and must not pollute the working tree.
data/runs/*/dialogues/canary/
data/runs/*/dialogues/regression_canary/
data/runs/*/dialogues/logs/
data/runs/*/dialogues/raw_outputs/
data/runs/*/dialogues/sessions/

# Local OS/editor noise.
.DS_Store
*.swp
*.swo
