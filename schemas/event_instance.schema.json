{
  "$defs": {
    "EventStatus": {
      "enum": [
        "no_event",
        "weak_signal",
        "upcoming",
        "occurred",
        "cancelled"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "EventStatusHistoryItem": {
      "properties": {
        "status": {
          "$ref": "#/$defs/EventStatus"
        },
        "month_index": {
          "title": "Month Index",
          "type": "integer"
        },
        "age": {
          "title": "Age",
          "type": "integer"
        },
        "transition_order": {
          "default": 0,
          "title": "Transition Order",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "month_index",
        "age"
      ],
      "title": "EventStatusHistoryItem",
      "type": "object"
    }
  },
  "properties": {
    "event_instance_id": {
      "title": "Event Instance Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "label_ko": {
      "title": "Label Ko",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EventStatus",
      "default": "no_event"
    },
    "status_history": {
      "items": {
        "$ref": "#/$defs/EventStatusHistoryItem"
      },
      "title": "Status History",
      "type": "array"
    },
    "start_month": {
      "default": 0,
      "title": "Start Month",
      "type": "integer"
    },
    "occurred_month": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred Month"
    },
    "cancelled_month": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelled Month"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "memory_delta_template_id": {
      "default": "",
      "title": "Memory Delta Template Id",
      "type": "string"
    },
    "action_impact_template_id": {
      "default": "",
      "title": "Action Impact Template Id",
      "type": "string"
    },
    "generation_source": {
      "default": "hazard",
      "title": "Generation Source",
      "type": "string"
    },
    "occurred_transition_order": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred Transition Order"
    },
    "causal_bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Bundle Id"
    },
    "bundle_event_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Event Index"
    },
    "source_template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Template Id"
    }
  },
  "required": [
    "event_instance_id",
    "event_id",
    "label_ko",
    "domain"
  ],
  "title": "EventInstance",
  "type": "object"
}
